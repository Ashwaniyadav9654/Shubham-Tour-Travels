# ──────────────────────────────────────────────────────────────────
# Copy to `.env` for local dev. `.env` is gitignored — NEVER put a real
# key in this file, it IS tracked by git.
# In production: Vercel → Project → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────

# ══ 1. GROQ — writes the day-by-day itinerary  [REQUIRED] ═════════
# https://console.groq.com/keys
# No VITE_ prefix on purpose: read only by /api, never sent to the browser.
# Without this the booking page returns an error — there is no fallback.
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile


# ══ 2. EMAIL — delivers the PDF  [REQUIRED to actually send] ══════
# Pick ONE of the two options below.
#
# ── Option A: Resend (easiest — free 3,000 emails/month) ──────────
# Sign up at https://resend.com, verify your domain, create an API key.
RESEND_API_KEY=

# ── Option B: SMTP (use your existing Gmail) ──────────────────────
# Gmail needs an App Password (not your normal password):
#   Google Account → Security → 2-Step Verification → App passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=shubhamtourandtravels9@gmail.com
# SMTP_PASS=

# Shown as the sender. With Resend this must be on a verified domain.
MAIL_FROM="Shubham Tour & Travels <bookings@shubhamtourtravels.in>"

# Where the lead notification + PDF goes internally.
TEAM_EMAIL=shubhamtourandtravels9@gmail.com


# ══ 3. DISTANCES  [OPTIONAL — free routing works without this] ════
# Without a key: OpenStreetMap Nominatim (geocode) + OSRM (route).
#   Free, no signup, accurate, but the public OSRM server is rate-limited
#   and not intended for heavy production traffic.
# With a key: Google Distance Matrix — better Indian road coverage,
#   production SLA, ~Rs 0.4 per lookup.
GOOGLE_MAPS_API_KEY=


# EmailJS has been removed entirely. Both the itinerary and the contact
# form now go through the transport configured in section 2 above.
